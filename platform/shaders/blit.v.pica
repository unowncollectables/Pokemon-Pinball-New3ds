; Vertex shader for drawing textured rectangles in screen pixels (written for this port).
; Input 0: x, y, z in screen pixels; input 1: texture coordinate (u, v).
; The projection matrix maps pixels to the rotated console screens (Mtx_OrthoTilt).

.fvec projection[4]

.constf myconst(0.0, 1.0, -1.0, 0.0)
.alias ones myconst.yyyy

.out outpos position
.out outtc0 texcoord0

.alias inpos v0
.alias intc  v1

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outtc0, intc

	end
.end
